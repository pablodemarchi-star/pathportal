FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-value
ADMIN_USERNAME=admin
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password', method='pbkdf2:sha256'))"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:1000000$replace-this-with-a-generated-hash
DATABASE_URL=sqlite:///academic_staff.db

# SMTP email sending
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@pathexaminations.com
SMTP_USE_TLS=1
